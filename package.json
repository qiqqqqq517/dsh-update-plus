{
  "name": "dsh-update-plus",
  "version": "1.0.0",
  "description": "DeepSeek Harness 桌面端更新与重启增强：多通道检查更新（稳定版 / 测试版 / 每日构建）、直接下载官方安装包（SHA-512 校验）、一键重启应用与 Host。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "update",
    "updater",
    "restart",
    "channel",
    "nightly",
    "beta",
    "stable"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiqqqqq517/dsh-update-plus.git"
  },
  "homepage": "https://github.com/qiqqqqq517/dsh-update-plus#readme",
  "bugs": {
    "url": "https://github.com/qiqqqqq517/dsh-update-plus/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node run-tests.mjs",
    "package:check": "node publish.mjs --check",
    "publish:npm": "node publish.mjs --registry https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.1",
      "profiles": [
        "desktop",
        "web"
      ],
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
