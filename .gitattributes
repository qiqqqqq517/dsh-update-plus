# Keep the repository LF-normalised so a Windows checkout does not report every
# file as modified. The runtime on Windows does not care; the diff does.
* text=auto eol=lf

# Batch files must keep CRLF: cmd.exe mis-parses LF-only files around labels.
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
